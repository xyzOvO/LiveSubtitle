<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiveSubtitle" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/deep_teal</item>
        <item name="colorPrimaryDark">@color/ink_teal</item>
        <item name="colorAccent">@color/mint</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/mist</item>
        <item name="android:textColorPrimary">@color/ink_teal</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
    <!-- Manifest and the old code path may still reference AppTheme; keep it as a safe alias. -->
    <style name="AppTheme" parent="Theme.LiveSubtitle" />
    <style name="StatusPill">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <!-- 悬浮窗工具条按钮：紧凑、可点、不引入 Button 的大背景。 -->
    <style name="OverlayToolButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>

